server {
    listen 80;
    server_name localhost;

    # Protected content
    location / {
        auth_request /auth;
        auth_request_set $auth_status $upstream_status;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        auth_request_set $auth_user $upstream_http_x_auth_user;
        auth_request_set $given_name $upstream_http_x_given_name;
        auth_request_set $access_token $cookie_access_token;
        
        # Only pass these headers if authentication was successful
        if ($auth_status = 200) {
            add_header X-User $auth_user;
        }
        
        error_page 401 = @error401;

        root /usr/share/nginx/html;
        index welcome.html;
        
        # Replace variables in HTML
        sub_filter '${given_name}' $given_name;
        sub_filter '${access_token}' $access_token;
        sub_filter_once off;
    }

    # Handle 401 errors by redirecting to login
    location @error401 {
        return 302 "$oauth2_keycloak_url/realms/master/protocol/openid-connect/auth?response_type=code&client_id=$oauth2_client_id&redirect_uri=$oauth2_redirect_uri&scope=openid%20profile%20email";
    }

    # OAuth2 callback handler
    location = /oauth2/callback {
        proxy_pass $oauth2_keycloak_url/realms/master/protocol/openid-connect/token;
        proxy_set_header Content-Type "application/x-www-form-urlencoded";
        
        # Convert the callback to a token request
        proxy_method POST;
        proxy_set_body "grant_type=authorization_code&client_id=$oauth2_client_id&client_secret=$oauth2_client_secret&code=$arg_code&redirect_uri=$oauth2_redirect_uri";
        
        # Handle the response
        proxy_intercept_errors off;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;

        # Set the token as a cookie
        add_header Set-Cookie "access_token=$upstream_http_access_token;Path=/;HttpOnly;SameSite=Lax;Max-Age=3600";
        
        # Redirect back to the main page
        return 302 /;
    }

    # Internal authentication request
    location = /auth {
        internal;
        proxy_pass $oauth2_keycloak_url/realms/master/protocol/openid-connect/userinfo;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        
        # Save user info in headers
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "Bearer $cookie_access_token";

        # Enable caching of successful auth results
        proxy_cache auth_cache;
        proxy_cache_valid 200 10m;
        proxy_cache_key $cookie_access_token;
        proxy_cache_use_stale error timeout http_500 http_502 http_503 http_504;
    }
}
